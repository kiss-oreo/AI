<Window x:Class="PortableDroid.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PortableDroid" Height="660" Width="960"
        MinHeight="520" MinWidth="780"
        Background="#0F172A"
        AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Deliberately flat and animation-free: this must feel instant on a 4 GB laptop. -->
        <SolidColorBrush x:Key="Panel" Color="#1E293B" />
        <SolidColorBrush x:Key="Text" Color="#E2E8F0" />
        <SolidColorBrush x:Key="Muted" Color="#94A3B8" />
        <SolidColorBrush x:Key="Accent" Color="#3B82F6" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#64748B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#334155" />
        </Style>

        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#7F1D1D" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding StatusColor}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding ProfileSummary}" Foreground="{StaticResource Muted}"
                               FontSize="11" Margin="18,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Start Android" Command="{Binding StartCommand}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource Secondary}" />
                    <Button Content="Restart" Command="{Binding RestartCommand}" Style="{StaticResource Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding BusyMessage}" Foreground="{StaticResource Muted}" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ResourceSummary}" Foreground="{StaticResource Muted}"
                           FontSize="11" />
            </Grid>
        </Border>

        <TabControl Background="#0F172A" BorderThickness="0" Margin="8">
            <!-- Applications -->
            <TabItem Header="Applications">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="#172033" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="12"
                                   Text="Drag an APK file anywhere onto this window to install it." />
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding Apps}" Background="{StaticResource Panel}"
                              BorderThickness="0" Foreground="{StaticResource Text}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PackageName}" Foreground="#94A3B8" FontSize="11" />
                                            <TextBlock Text="  •  " Foreground="#94A3B8" FontSize="11" />
                                            <TextBlock Text="{Binding VersionName}" Foreground="#94A3B8" FontSize="11" />
                                            <TextBlock Text="  •  " Foreground="#94A3B8" FontSize="11" />
                                            <TextBlock Text="{Binding Compatibility}" Foreground="#64748B" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Launch"
                                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Stop" Style="{StaticResource Secondary}"
                                                Command="{Binding DataContext.StopAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Remove" Style="{StaticResource Danger}"
                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="+ Install APK" Command="{Binding InstallApkCommand}" />
                        <Button Content="Refresh" Command="{Binding RefreshLibraryCommand}"
                                Style="{StaticResource Secondary}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Dashboard -->
            <TabItem Header="Dashboard">
                <StackPanel Margin="16">
                    <TextBlock Text="This computer" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding HardwareSummary}" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,16" />

                    <TextBlock Text="Runtime" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding ProfileSummary}" Foreground="{StaticResource Muted}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Resources" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding ResourceSummary}" Foreground="{StaticResource Muted}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Portable folder" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding RootPath}" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Everything lives in this folder. Copy it to another drive and your apps and data come with it." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}"
                                Style="{StaticResource Secondary}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings">
                <ScrollViewer>
                    <StackPanel Margin="16">
                        <TextBlock Text="Performance" Style="{StaticResource Heading}" />
                        <TextBlock Text="Performance profile" Foreground="{StaticResource Muted}" FontSize="11" />
                        <ComboBox ItemsSource="{Binding PerformanceProfiles}"
                                  SelectedItem="{Binding SelectedPerformanceProfile}"
                                  Width="220" HorizontalAlignment="Left" Margin="0,4,0,12" />

                        <TextBlock Text="Graphics mode" Foreground="{StaticResource Muted}" FontSize="11" />
                        <ComboBox ItemsSource="{Binding GraphicsModes}"
                                  SelectedItem="{Binding SelectedGraphicsMode}"
                                  Width="220" HorizontalAlignment="Left" Margin="0,4,0,12" />

                        <TextBlock Text="Memory for Android (MB, 0 = automatic)" Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBox Text="{Binding Settings.Runtime.MemoryMB, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" HorizontalAlignment="Left" Margin="0,4,0,12" />

                        <TextBlock Text="CPU cores (0 = automatic)" Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBox Text="{Binding Settings.Runtime.CpuCores, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" HorizontalAlignment="Left" Margin="0,4,0,12" />

                        <TextBlock Text="Resolution" Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBox Text="{Binding Settings.Runtime.Resolution, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" HorizontalAlignment="Left" Margin="0,4,0,12" />

                        <TextBlock Text="Android data disk size (GB, applies to new profiles)"
                                   Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBox Text="{Binding Settings.Storage.UserdataSizeGB, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" HorizontalAlignment="Left" Margin="0,4,0,16" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" />
                        </StackPanel>

                        <TextBlock Text="Backups" Style="{StaticResource Heading}" />
                        <TextBlock Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Android must be stopped before a backup can be made, so that your data is not copied while it is being written." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Create backup" Command="{Binding BackupCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Backups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Muted}"
                                               FontSize="11" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Logs -->
            <TabItem Header="Logs">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding LogChannels}" SelectedItem="{Binding SelectedLogChannel}"
                                  Width="180" Margin="0,0,8,0" />
                        <Button Content="Refresh" Command="{Binding RefreshLogsCommand}"
                                Style="{StaticResource Secondary}" />
                        <Button Content="Open logs folder" Command="{Binding OpenLogsCommand}"
                                Style="{StaticResource Secondary}" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                             Background="#0B1220" Foreground="#94A3B8" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
